#: ../../DailyMerchant.cs:31
msgid "让旅商每天到访：原版流动旅商每天只有约 22% 机会出现，这里改成每天必到，生成与播报仍走原版。"
msgstr "Daily Travelling Merchant: vanilla only gives him about a 22% chance per day, this makes him show up every day; spawning and broadcasts stay vanilla."

#: ../../DailyMerchant.cs:219
msgid "原版已放行"
msgstr "Vanilla allowed it"

#: ../../DailyMerchant.cs:227
msgid "原版拒绝：月食天不生成旅商"
msgstr "Vanilla refused: no merchant during an eclipse"

#: ../../DailyMerchant.cs:230
msgid "原版拒绝：夜晚不生成旅商"
msgstr "Vanilla refused: no merchant at night"

#: ../../DailyMerchant.cs:233
msgid "原版拒绝：入侵进行中"
msgstr "Vanilla refused: an invasion is in progress"

#: ../../DailyMerchant.cs:239
#, csharp-format
msgid "原版拒绝：场上已有旅商（槽位 {0}，生命 {1}）"
msgstr "Vanilla refused: a merchant is already here (slot {0}, life {1})"

#: ../../DailyMerchant.cs:262
msgid "原版拒绝：既没有已入住的城镇 NPC，也没有可搬入的空房"
msgstr "Vanilla refused: no housed town NPC and no empty room to move one into"

#: ../../DailyMerchant.cs:263
msgid "原版拒绝：TownManager 找不到可用的落脚点"
msgstr "Vanilla refused: TownManager could not find a usable spot"

#: ../../DailyMerchant.cs:275
#, csharp-format
msgid "原版已通过全部条件（有 {0} 位已入住 NPC）但仍没生成：活跃 NPC {1}/{2}"
msgstr "Vanilla passed every condition ({0} housed NPCs) but still did not spawn: active NPCs {1}/{2}"

#: ../../DailyMerchant.cs:310
msgid "旅商当前不在场"
msgstr "The merchant is not here right now"

#: ../../DailyMerchant.cs:320
msgid "现在是夜晚（原版入夜后不再来）"
msgstr "It is night (vanilla stops after dusk)"

#: ../../DailyMerchant.cs:322
msgid "日晷 / Moondial 生效中（原版此时不掷骰）"
msgstr "A Sundial / Moondial is active (vanilla does not roll then)"

#: ../../DailyMerchant.cs:324
#, csharp-format
msgid "已过上午4:30 + {0} 分钟"
msgstr "Past 4:30 AM + {0} minutes"

#: ../../DailyMerchant.cs:326
msgid "月食天不生成旅商"
msgstr "No merchant during an eclipse"

#: ../../DailyMerchant.cs:330
#, csharp-format
msgid "城镇里只有 {0} 位 NPC，原版要求至少 2 位"
msgstr "The town only has {0} NPCs, vanilla needs at least 2"

#: ../../DailyMerchant.cs:334
#, csharp-format
msgid "城镇里有 {0} 位 NPC，但都没住进房子，原版没有落脚点（静默等待中）"
msgstr "The town has {0} NPCs but none of them is housed, vanilla has no spot (waiting silently)"

#: ../../DailyMerchant.cs:336
msgid "条件已满足，正在按原版生成"
msgstr "All conditions met, spawning the vanilla way"

#: ../../DailyMerchant.cs:346
msgid "让旅商每天到访（/merchant summon|despawn|check|status）"
msgstr "Makes the Travelling Merchant visit daily (/merchant summon|despawn|check|status)"

#: ../../DailyMerchant.cs:375
msgid "场上已经有旅商了。"
msgstr "There is already a merchant here."

#: ../../DailyMerchant.cs:379
msgid "已召唤，旅商现在在城镇里。"
msgstr "Summoned; the merchant is now in town."

#: ../../DailyMerchant.cs:384
msgid "召唤失败："
msgstr "Summon failed: "

#: ../../DailyMerchant.cs:392
msgid "场上本来就没有旅商。"
msgstr "There was no merchant here in the first place."

#: ../../DailyMerchant.cs:398
msgid "已请旅商离场。"
msgstr "Sent the merchant away."

#: ../../DailyMerchant.cs:409
msgid "已手动判定一次："
msgstr "Ran one arrival check manually: "

#: ../../DailyMerchant.cs:420
msgid "指令用法："
msgstr "Command usage:"

#: ../../DailyMerchant.cs:421
msgid "立刻召唤旅商（/merchant 召唤）"
msgstr "Summon the merchant right away (/merchant 召唤)"

#: ../../DailyMerchant.cs:422
msgid "请旅商离场（/merchant 离开）"
msgstr "Send the merchant away (/merchant 离开)"

#: ../../DailyMerchant.cs:423
msgid "手动跑一次到访判定（/merchant 检查）"
msgstr "Run one arrival check manually (/merchant 检查)"

#: ../../DailyMerchant.cs:424
msgid "查看到访状态与城镇条件（/merchant 状态）"
msgstr "Show arrival status and town conditions (/merchant 状态)"

#: ../../DailyMerchant.cs:433
msgid "启用中"
msgstr "Enabled"

#: ../../DailyMerchant.cs:434
msgid "旅商 NPC ID ="
msgstr "Merchant NPC ID ="

#: ../../DailyMerchant.cs:435
msgid "每天到访"
msgstr "Daily arrival"

#: ../../DailyMerchant.cs:435
msgid "原版 22.12%"
msgstr "vanilla 22.12%"

#: ../../DailyMerchant.cs:436
msgid "窗口"
msgstr "Window"

#: ../../DailyMerchant.cs:436
msgid "上午4:30 起"
msgstr "from 4:30 AM for"

#: ../../DailyMerchant.cs:436
msgid "分钟"
msgstr "minutes"

#: ../../DailyMerchant.cs:437
msgid "当前："
msgstr "Now: "

#: ../../DailyMerchant.cs:438
msgid "场上旅商"
msgstr "merchants on the field"

#: ../../DailyMerchant.cs:438
msgid "位"
msgstr ", position"

#: ../../DailyMerchant.cs:438
msgid "位置"
msgstr "position"

#: ../../DailyMerchant.cs:439
msgid "城镇："
msgstr "Town: "

#: ../../DailyMerchant.cs:439
msgid "位 NPC（已入住"
msgstr " NPCs (housed"

#: ../../DailyMerchant.cs:440
msgid "待搬入空房"
msgstr ", rooms waiting to be filled"

#: ../../DailyMerchant.cs:440
msgid "判定已跑"
msgstr "checks run"

#: ../../DailyMerchant.cs:441
msgid "次（每秒 1 次自动，空服不跑）"
msgstr " times (once per second automatically, not on an empty server)"

#: ../../DailyMerchant.cs:442
